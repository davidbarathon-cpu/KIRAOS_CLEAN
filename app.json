{
  "expo": {
    "name": "KiraOS_Clean",
    "slug": "kiraosclean",
    "projectId": "f5161002-4544-4555-8933-c2303c6f9188",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Kira a besoin de la reconnaissance vocale.",
        "NSMicrophoneUsageDescription": "Kira a besoin du micro."
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6C63FF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kira a besoin d'accéder à tes photos.",
          "cameraPermission": "Kira a besoin de la caméra."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Kira a besoin du micro.",
          "speechRecognitionPermission": "Kira a besoin de la reconnaissance vocale."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kira a besoin de ta position."
        }
      ],
      "expo-web-browser",
      "./plugins/withPorcupineAssets.js",
      "expo-sharing",
      "expo-quick-actions",
      "expo-secure-store",
      "expo-audio",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "KiraMaxi",
              "label": "Kira OS — Maxi",
              "description": "Tableau de bord Kira",
              "minWidth": "250dp",
              "minHeight": "300dp",
              "targetCellWidth": 5,
              "targetCellHeight": 5,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-asset"
    ],
    "android": {
      "permissions": [
        "android.permission.NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "FOREGROUND_SERVICE",
"FOREGROUND_SERVICE_MICROPHONE",
"POST_NOTIFICATIONS",
"WAKE_LOCK"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.bdadoo.KiraOS_Clean",
      "config": {
        "googleMaps": {
          "apiKey": "COLLE_TA_CLE_GOOGLE_MAPS_ANDROID_ICI"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "3b752b86-2403-41df-8717-7a732907753d"
      }
    }
  }
}
